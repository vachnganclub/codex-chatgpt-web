{%- comment -%}
  Product card used on Home, Collection and Search.
  Always shows the selling unit ("card" for single cards, "pack" for bulk packs).
  Accepts:
  - product: {Object}
{%- endcomment -%}
{%- capture units -%}{%- render 'product-meta', product: product, output: 'units' -%}{%- endcapture -%}
{%- capture rarity -%}{%- render 'product-meta', product: product, output: 'rarity' -%}{%- endcapture -%}
{%- capture line -%}{%- render 'product-meta', product: product, output: 'line' -%}{%- endcapture -%}
{%- liquid
  assign units = units | strip
  assign rarity = rarity | strip
  assign line = line | strip
  assign unit_for_price = ''
  unless units contains '·'
    assign unit_for_price = units
  endunless
-%}
<article class="card{% if line != blank %} card--{{ line }}{% endif %}">
  <a href="{{ product.url }}" class="card__link">
    <div class="card__media">
      {%- if product.featured_media -%}
        {%- assign card_alt = product.featured_media.alt | default: product.title -%}
        {{
          product.featured_media
          | image_url: width: 600
          | image_tag:
            loading: 'lazy',
            widths: '200, 300, 400, 600',
            sizes: '(min-width: 990px) 25vw, 50vw',
            alt: card_alt
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
      <div class="card__badges">
        {%- if product.available == false -%}
          <span class="badge badge--soldout">{{ 'products.product.sold_out' | t }}</span>
        {%- elsif product.compare_at_price > product.price -%}
          <span class="badge badge--sale">{{ 'products.product.on_sale' | t }}</span>
        {%- endif -%}
        {%- if rarity != blank -%}
          <span class="badge badge--rarity">{{ rarity }}</span>
        {%- endif -%}
      </div>
    </div>
    <div class="card__info">
      <h3 class="card__title">{{ product.title | escape }}</h3>
      {%- if units != blank -%}
        <p class="card__units">
          <span class="visually-hidden">{{ 'products.product.sold_by' | t }}</span>
          {%- assign unit_list = units | split: ' · ' -%}
          {%- for u in unit_list -%}
            <span class="unit-pill unit-pill--{{ u | handle }}">{{ u }}</span>
          {%- endfor -%}
        </p>
      {%- endif -%}
      {% render 'price', product: product, show_from: true, unit: unit_for_price %}
    </div>
  </a>
</article>
