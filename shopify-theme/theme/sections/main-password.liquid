<section class="section password">
  <div class="page-width page-width--narrow empty-state">
    <h1 class="page__title">{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}
      <p>{{ shop.password_message }}</p>
    {%- endif -%}
    {%- form 'customer', class: 'password__newsletter' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success">{{ 'general.password.subscribed' | t }}</p>
      {%- else -%}
        <label class="visually-hidden" for="PasswordNewsletter">{{ 'general.password.email' | t }}</label>
        <input type="email" id="PasswordNewsletter" name="contact[email]" required placeholder="{{ 'general.password.email' | t }}">
        <button type="submit" class="button">{{ 'general.password.notify' | t }}</button>
        {{ form.errors | default_errors }}
      {%- endif -%}
    {%- endform -%}
    <details class="password__login">
      <summary>{{ 'general.password.enter_using_password' | t }}</summary>
      {%- form 'storefront_password' -%}
        {{ form.errors | default_errors }}
        <label class="visually-hidden" for="Password">{{ 'general.password.password' | t }}</label>
        <input type="password" name="password" id="Password" autocomplete="current-password" placeholder="{{ 'general.password.password' | t }}">
        <button type="submit" class="button">{{ 'general.password.enter' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
