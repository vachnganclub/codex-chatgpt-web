{%- comment -%}
  S01 — CTA cards to /collections/pokemon, /collections/one-piece,
  /pages/wholesale-inquiry and /pages/feedback.
{%- endcomment -%}
<section class="section link-cards">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="link-cards__grid">
      {%- for block in section.blocks -%}
        <a
          href="{{ block.settings.link | default: '#' }}"
          class="link-card link-card--{{ block.settings.theme }}"
          {{ block.shopify_attributes }}
        >
          <div class="link-card__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 990px) 25vw, 50vw', alt: block.settings.title
              }}
            {%- elsif block.settings.demo_image != 'none' -%}
              {%- capture demo_file -%}demo-tile-{{ block.settings.demo_image }}.jpg{%- endcapture -%}
              <img src="{{ demo_file | asset_url }}" alt="" width="1000" height="1000" loading="lazy">
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="link-card__body">
            <h3 class="link-card__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="link-card__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
            <span class="link-card__cta">{{ block.settings.cta | escape }} &rarr;</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Link cards",
  "settings": [
    { "type": "text", "id": "heading", "default": "Shop by game", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Square 1:1, at least 800 x 800 px." },
        {
          "type": "select",
          "id": "demo_image",
          "label": "Demo artwork (used when no image is selected)",
          "default": "none",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "pokemon", "label": "Pokémon cards" },
            { "value": "onepiece", "label": "One Piece cards" },
            { "value": "wholesale", "label": "Bulk pack" },
            { "value": "feedback", "label": "Reviews" }
          ]
        },
        { "type": "text", "id": "title", "default": "Card title", "label": "Title" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "text", "id": "cta", "default": "Shop now", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "theme",
          "label": "Color",
          "default": "default",
          "options": [
            { "value": "default", "label": "Default" },
            { "value": "pokemon", "label": "Pokémon" },
            { "value": "one-piece", "label": "One Piece" },
            { "value": "accent", "label": "Accent" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Link cards",
      "blocks": [{ "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}
