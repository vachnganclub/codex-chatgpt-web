{%- comment -%}
  S01 — Hero banner. Desktop image 16:9 or wider (min 2000 px wide), optional
  separate mobile image 4:5 (min 900 px wide). Keep files under ~500 KB.
{%- endcomment -%}
<section class="banner banner--{{ section.settings.height }}" style="--overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">
  <div class="banner__media">
    {%- if section.settings.image != blank -%}
      {%- capture desktop_class -%}banner__image{% if section.settings.image_mobile != blank %} banner__image--desktop{% endif %}{%- endcapture -%}
      {{
        section.settings.image
        | image_url: width: 3000
        | image_tag:
          class: desktop_class,
          widths: '750, 1100, 1500, 2000, 3000',
          sizes: '100vw',
          fetchpriority: 'high',
          alt: section.settings.image.alt
      }}
      {%- if section.settings.image_mobile != blank -%}
        {{
          section.settings.image_mobile
          | image_url: width: 1200
          | image_tag:
            class: 'banner__image banner__image--mobile',
            widths: '375, 750, 1100',
            sizes: '100vw',
            alt: section.settings.image_mobile.alt
        }}
      {%- endif -%}
    {%- elsif section.settings.demo_image -%}
      <picture>
        <source media="(max-width: 749px)" srcset="{{ 'demo-hero-mobile.jpg' | asset_url }}">
        <img src="{{ 'demo-hero.jpg' | asset_url }}" class="banner__image" alt="" width="2400" height="1350" fetchpriority="high">
      </picture>
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'banner__image placeholder-svg' }}
    {%- endif -%}
  </div>
  <div class="banner__content page-width banner__content--{{ section.settings.text_alignment }}">
    <div class="banner__box">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2 class="banner__heading h1" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
          {%- when 'text' -%}
            <div class="banner__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'button' -%}
            {%- if block.settings.label != blank -%}
              <a
                href="{{ block.settings.link | default: '#' }}"
                class="button{% if block.settings.style == 'secondary' %} button--secondary{% elsif block.settings.style == 'accent' %} button--accent{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.label | escape -}}
              </a>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image banner",
  "class": "section-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image",
      "info": "16:9 or wider, at least 2000 px wide, under 500 KB."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image (optional)",
      "info": "4:5 portrait, at least 900 px wide."
    },
    {
      "type": "checkbox",
      "id": "demo_image",
      "default": true,
      "label": "Show demo artwork when no image is selected"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Banner height",
      "default": "medium",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Content position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 35,
      "label": "Image overlay opacity"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "default": "Your store headline", "label": "Heading" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "default": "<p>Short supporting sentence supplied by the store owner.</p>", "label": "Text" }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "default": "Shop now", "label": "Label" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "default": "primary",
          "options": [
            { "value": "primary", "label": "Primary" },
            { "value": "secondary", "label": "Outline" },
            { "value": "accent", "label": "Accent" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image banner",
      "blocks": [
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
