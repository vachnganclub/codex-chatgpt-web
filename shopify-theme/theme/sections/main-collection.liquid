{%- comment -%}
  S10 — Collection pages, e.g. /collections/pokemon and /collections/one-piece.
  Uses Shopify's native Storefront filtering (configure filters in the free
  "Search & Discovery" app: Availability, Price, Product type, tag/metafield "Rarity")
  and native sorting (price, newest).
{%- endcomment -%}
{%- liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign total_active_values = 0
  for filter in collection.filters
    assign total_active_values = total_active_values | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != null or filter.max_value.value != null
        assign total_active_values = total_active_values | plus: 1
      endif
    endif
  endfor
  assign line = collection.handle
-%}

<section class="section collection collection--{{ line }}">
  <div class="page-width">
    <header class="collection__header">
      <h1 class="collection__title">{{ collection.title | escape }}</h1>
      {%- if collection.description != blank -%}
        <div class="collection__description rte">{{ collection.description }}</div>
      {%- endif -%}
    </header>

    {%- paginate collection.products by section.settings.products_per_page -%}
      <form class="facets" id="FacetsForm" data-facets-form>
        <details class="facets__drawer" {% if total_active_values > 0 %}open{% endif %}>
          <summary class="button button--secondary button--small facets__toggle">
            {{ 'collections.filters.title' | t }}
            {%- if total_active_values > 0 %} ({{ total_active_values }}){% endif -%}
          </summary>
          <div class="facets__panel">
            {%- for filter in collection.filters -%}
              <fieldset class="facets__group">
                <legend class="facets__legend">{{ filter.label | escape }}</legend>
                {%- case filter.type -%}
                  {%- when 'boolean', 'list' -%}
                    <ul class="facets__list" role="list">
                      {%- for value in filter.values -%}
                        <li>
                          <label class="facets__checkbox{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                            <input
                              type="checkbox"
                              name="{{ value.param_name }}"
                              value="{{ value.value }}"
                              {% if value.active %}
                                checked
                              {% endif %}
                              {% if value.count == 0 and value.active == false %}
                                disabled
                              {% endif %}
                              data-autosubmit
                            >
                            <span>{{ value.label | escape }} <span class="facets__count">({{ value.count }})</span></span>
                          </label>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- when 'price_range' -%}
                    {%- liquid
                      assign currency_symbol = cart.currency.symbol
                      assign max_price = filter.range_max | money_without_currency | remove: ','
                    -%}
                    <div class="facets__price">
                      <label>
                        <span class="visually-hidden">{{ 'collections.filters.from' | t }}</span>
                        <span>{{ currency_symbol }}</span>
                        <input
                          type="number"
                          name="{{ filter.min_value.param_name }}"
                          {% if filter.min_value.value %}
                            value="{{ filter.min_value.value | money_without_currency | remove: ',' }}"
                          {% endif %}
                          placeholder="0"
                          min="0"
                          max="{{ max_price }}"
                          step="any"
                        >
                      </label>
                      <span aria-hidden="true">–</span>
                      <label>
                        <span class="visually-hidden">{{ 'collections.filters.to' | t }}</span>
                        <span>{{ currency_symbol }}</span>
                        <input
                          type="number"
                          name="{{ filter.max_value.param_name }}"
                          {% if filter.max_value.value %}
                            value="{{ filter.max_value.value | money_without_currency | remove: ',' }}"
                          {% endif %}
                          placeholder="{{ max_price }}"
                          min="0"
                          max="{{ max_price }}"
                          step="any"
                        >
                      </label>
                      <button type="submit" class="button button--small">{{ 'collections.filters.apply' | t }}</button>
                    </div>
                {%- endcase -%}
              </fieldset>
            {%- endfor -%}
            {%- if total_active_values > 0 -%}
              <a href="{{ collection.url }}?sort_by={{ sort_by }}" class="link-arrow facets__clear">{{ 'collections.filters.clear_all' | t }}</a>
            {%- endif -%}
          </div>
        </details>

        <div class="facets__sort">
          <label for="SortBy">{{ 'collections.sorting.title' | t }}</label>
          <select name="sort_by" id="SortBy" data-autosubmit>
            {%- for option in collection.sort_options -%}
              <option
                value="{{ option.value | escape }}"
                {% if option.value == sort_by %}
                  selected
                {% endif %}
              >
                {{- option.name | escape -}}
              </option>
            {%- endfor -%}
          </select>
          <p class="facets__count-total">{{ 'collections.product_count' | t: count: collection.products_count }}</p>
        </div>
      </form>

      {%- if collection.products.size == 0 -%}
        <div class="empty-state">
          <p>{{ 'collections.empty' | t }}</p>
          {%- if total_active_values > 0 -%}
            <a href="{{ collection.url }}" class="button">{{ 'collections.filters.clear_all' | t }}</a>
          {%- endif -%}
        </div>
      {%- else -%}
        <ul class="product-grid" role="list">
          {%- for product in collection.products -%}
            <li>{% render 'product-card', product: product %}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Product grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24,
      "label": "Products per page"
    },
    {
      "type": "paragraph",
      "content": "Filters come from Online Store > Navigation > Collection and search filters (Search & Discovery app)."
    }
  ]
}
{% endschema %}
