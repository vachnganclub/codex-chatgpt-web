<section class="section">
  <div class="page-width">
    <h1 class="section__heading">{{ 'templates.collections.title' | t }}</h1>
    <ul class="link-cards__grid" role="list">
      {%- for collection in collections -%}
        <li>
          <a href="{{ collection.url }}" class="link-card link-card--{{ collection.handle }}">
            <div class="link-card__media">
              {%- if collection.featured_image -%}
                {%- assign col_alt = collection.featured_image.alt | default: collection.title -%}
                {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 990px) 25vw, 50vw', alt: col_alt }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="link-card__body">
              <h2 class="link-card__title">{{ collection.title | escape }}</h2>
              <span class="link-card__cta">{{ 'collections.product_count' | t: count: collection.products_count }} &rarr;</span>
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": []
}
{% endschema %}
