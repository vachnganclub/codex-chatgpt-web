<article class="section article">
  <div class="page-width page-width--narrow">
    <p class="card__meta">{{ article.published_at | time_tag: format: 'date' }}</p>
    <h1 class="page__title">{{ article.title | escape }}</h1>
    {%- if article.image -%}
      <div class="article__image">
        {%- assign art_alt = article.image.alt | default: article.title -%}
        {{ article.image | image_url: width: 1400 | image_tag: widths: '600, 1000, 1400', sizes: '(min-width: 990px) 800px, 100vw', alt: art_alt }}
      </div>
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
    <p><a href="{{ blog.url }}" class="link-arrow">&larr; {{ blog.title | escape }}</a></p>
  </div>
</article>

{% schema %}
{
  "name": "Blog post",
  "settings": []
}
{% endschema %}
