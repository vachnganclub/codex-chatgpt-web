<section class="section rich-text{% if section.settings.background %} section--surface{% endif %}">
  <div class="page-width page-width--narrow rich-text__inner rich-text__inner--{{ section.settings.alignment }}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          <h2 class="rich-text__heading" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
        {%- when 'text' -%}
          <div class="rte rich-text__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          {%- if block.settings.label != blank -%}
            <a href="{{ block.settings.link | default: '#' }}" class="button{% if block.settings.outline %} button--secondary{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "checkbox",
      "id": "background",
      "default": false,
      "label": "Tinted background"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "text", "id": "heading", "default": "About our store", "label": "Heading" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "default": "<p>Introduce your store here: who you are, which cards you sell and how you ship.</p>", "label": "Text" }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "default": "Learn more", "label": "Label" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "outline", "default": false, "label": "Outline style" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rich text",
      "blocks": [{ "type": "heading" }, { "type": "text" }]
    }
  ]
}
{% endschema %}
