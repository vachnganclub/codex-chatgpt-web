<section class="section search-page">
  <div class="page-width">
    <h1 class="section__heading">{{ 'general.search.search' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <label class="visually-hidden" for="SearchInput">{{ 'general.search.search' | t }}</label>
      <input type="search" id="SearchInput" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="button">{{ 'general.search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        <p class="search-page__count">{{ 'general.search.results_count' | t: count: search.results_count, terms: search.terms }}</p>
        {%- if search.results_count > 0 -%}
          <ul class="product-grid" role="list">
            {%- for item in search.results -%}
              <li>
                {%- case item.object_type -%}
                  {%- when 'product' -%}
                    {% render 'product-card', product: item %}
                  {%- else -%}
                    <article class="card card--text">
                      <a href="{{ item.url }}" class="card__link">
                        <div class="card__info">
                          <h3 class="card__title">{{ item.title | escape }}</h3>
                          <p>{{ item.content | strip_html | truncatewords: 20 }}</p>
                        </div>
                      </a>
                    </article>
                {%- endcase -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if paginate.pages > 1 -%}
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search results",
  "settings": []
}
{% endschema %}
